# Copia este archivo a ".env" y ajusta los valores para tu SQL Server.
#
# Formato general:
# sqlserver://HOST:PUERTO;database=NOMBRE_BD;user=USUARIO;password=CLAVE;trustServerCertificate=true
#
# Ejemplo con SQL Server local (instancia por defecto, puerto 1433):
DATABASE_URL="sqlserver://localhost:1433;database=ComprasSinco;user=sa;password=TU_CLAVE;trustServerCertificate=true"

# Ejemplo con autenticación integrada de Windows (requiere el driver
# msnodesqlv8 configurado aparte; lo más simple en la mayoría de los
# casos es usar un login de SQL como el de arriba).
# DATABASE_URL="sqlserver://localhost:1433;database=ComprasSinco;integratedSecurity=true;trustServerCertificate=true"
