// Prisma ORM con migraciones (prisma migrate) sobre SQLite.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Record {
  id                  String   @id @default(cuid())
  localSeq            Int?     @unique // número autoincremental visible (# en la tabla), asignado desde Meta.nextLocalSeq
  informe             String?
  fechaSolicitud      String?
  fechaEntrega        String?
  area                String?
  responsable         String?
  estado              String?
  categoria           String?
  descripcion         String?
  medioPago           String?
  licitacion          String?
  estadoLegalizacion  String?
  proveedor           String?
  fe                  String?
  valorConIva         Float?
  valorSinIva         Float?
  valorCot            Float?
  observaciones       String?
  radicado            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("records")
}

// Auditoría de acciones sobre registros (crear / editar / eliminar / radicar).
// userId no tiene relación FK a propósito: si el usuario se elimina, el log
// debe seguir existiendo con el nombre/correo capturados en el momento.
model AuditLog {
  id         String   @id @default(cuid())
  action     String   // "crear" | "editar" | "eliminar" | "radicar"
  recordId   String
  recordInfo String?
  userId     String?
  userNombre String?
  userEmail  String?
  changes    String?  // JSON: [{ field, label, before, after }]
  createdAt  DateTime @default(now())

  @@index([recordId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Meta {
  id            Int      @id @default(1)
  sourceFile    String?
  sourceSheet   String?
  nextLocalSeq  Int      @default(1)
  updatedAt     DateTime @updatedAt

  @@map("meta")
}

// role: "admin" | "registro" | "legalizar" | "radicar" (ver lib/roles.js)
model User {
  id            String         @id @default(cuid())
  nombre        String
  email         String         @unique
  password      String
  role          String
  activo        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]

  @@map("users")
}

// Historial de conversaciones del Agente IA (una por hilo de chat).
model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  model     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("agent_conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // "user" | "model"
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("agent_messages")
}
