// Prisma ORM con migraciones (prisma migrate) sobre SQLite.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Record {
  id                  String   @id @default(cuid())
  informe             String?
  fechaSolicitud      String?
  fechaEntrega        String?
  area                String?
  responsable         String?
  estado              String?
  categoria           String?
  descripcion         String?
  medioPago           String?
  licitacion          String?
  estadoLegalizacion  String?
  proveedor           String?
  fe                  String?
  valorConIva         Float?
  valorSinIva         Float?
  valorCot            Float?
  observaciones       String?
  radicado            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("records")
}

model Meta {
  id            Int      @id @default(1)
  sourceFile    String?
  sourceSheet   String?
  nextLocalSeq  Int      @default(1)
  updatedAt     DateTime @updatedAt

  @@map("meta")
}

// role: "admin" | "registro" | "legalizar" | "radicar" (ver lib/roles.js)
model User {
  id            String         @id @default(cuid())
  nombre        String
  email         String         @unique
  password      String
  role          String
  activo        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]

  @@map("users")
}

// Historial de conversaciones del Agente IA (una por hilo de chat).
model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  model     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("agent_conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // "user" | "model"
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("agent_messages")
}
