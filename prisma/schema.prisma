// Esquema de Prisma para SQLite.
// Documentación: https://www.prisma.io/docs/orm/overview/databases/sqlite

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PurchaseRecord {
  id                 String    @id @default(uuid())

  // Mes/informe de origen (ej. "ENERO"), útil para reportes históricos
  informe            String?

  fechaSolicitud     DateTime?
  fechaEntrega       DateTime?

  area               String?
  responsable        String?
  estado             String?
  categoria          String?
  descripcion        String

  medioPago          String?
  licitacion         String?
  estadoLegalizacion String?
  proveedor          String?
  fe                 String?

  valorConIva        Float?
  valorSinIva        Float?
  valorCot           Float?

  observaciones      String?
  radicado           Boolean   @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("purchase_records")
}
