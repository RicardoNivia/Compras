DATABASE_URL="postgresql://postgres:tu-password@localhost:5432/compras"
SESSION_SECRET="change-me-to-a-random-string"
# En Azure se llama ANTROPIC_API_KEY (sin H); el código acepta ese nombre y ANTHROPIC_API_KEY.
ANTROPIC_API_KEY="your-anthropic-api-key"

# ---------- Notificaciones por Teams (docs/notificaciones-diseno.md §10) ----------
# desactivado | simulado (arma la tarjeta y no la envía) | real
TEAMS_MODO=desactivado
# URL del flujo de Power Automate (secreto: nunca en el repositorio)
TEAMS_WEBHOOK_URL=
# Secreto compartido que valida el flujo
TEAMS_CLAVE_FLUJO=
# Solo en local: redirige TODO envío a Teams a este correo
TEAMS_DESTINO_PRUEBA=
# Base de los enlaces "Ver en el panel"
APP_URL=http://localhost:3000
# Hora local del programador (obligatoria en producción)
TZ=America/Bogota
# Elegir canal (Teams / correo) al crear notificaciones: visible por defecto; 0 lo oculta
NOTIFICACIONES_ELEGIR_CANAL=1

# Modelos de IA en orden (opcional). Sin esto se usa claude-haiku-4-5-20251001 en todos los ambientes.
# Ver backend/lib/anthropicModels.js. Ejemplo (comprobar antes que la clave de producción los permite):
# ANTHROPIC_MODELOS=claude-opus-5-5,claude-sonnet-5-5
# ANTHROPIC_MODELOS_AUTO=claude-sonnet-5-5,claude-opus-5-5

# ---------- Correo vinculado y agente de correo (docs/correo-agente-proveedores.md) ----------
# desactivado | simulado (sin Microsoft: se prueba pegando un correo en Mi correo) | real
CORREO_MODO=
# App registrada en Microsoft Entra ID (TI). El secreto nunca va al repositorio.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Opcional: por defecto APP_URL + /api/correo/callback (debe coincidir con la registrada en Entra ID)
MS_GRAPH_REDIRECT_URI=
# Clave para cifrar los tokens guardados (si falta se deriva de SESSION_SECRET; cambiarla obliga a volver a vincular)
CORREO_CLAVE_CIFRADO=
# 0 apaga la revisión automática cada 10 minutos
CORREO_AGENTE_AUTO=
