# Conexión a SQL Server Express (instancia SQLEXPRESS) con autenticación
# integrada de Windows. Requiere haber ejecutado una vez, como Administrador,
# el script scripts/enable-sqlexpress-tcp.ps1 para habilitar TCP/IP.
DATABASE_URL="sqlserver://localhost:1435;database=Compras;integratedSecurity=true;trustServerCertificate=true"
